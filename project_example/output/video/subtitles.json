[
  {
    "start": 1.0,
    "end": 3.48,
    "text": "Trông như mặt trời đã lặn rồi.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_1",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_6456e7387f484e8dab48e27cca0623e4"
  },
  {
    "start": 3.68,
    "end": 8.63,
    "text": "Trận cầu lông bãi biển của chúng ta gay gắt quá,",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_2",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_6456e7387f484e8dab48e27cca0623e4"
  },
  {
    "start": 8.63,
    "end": 10.88,
    "text": "gần như không để ý.",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_2",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_6456e7387f484e8dab48e27cca0623e4"
  },
  {
    "start": 11.92,
    "end": 14.36,
    "text": "Trước đây bầu trời xanh ngắt.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_3",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_0"
  },
  {
    "start": 14.56,
    "end": 16.34,
    "text": "Giờ nó cam rồi.",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_4",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_0"
  },
  {
    "start": 17.42,
    "end": 19.38,
    "text": "Màu sắc thật bí ẩn.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_6",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_1"
  },
  {
    "start": 20.42,
    "end": 22.82,
    "text": "Cái bạn đang nhìn chỉ là ánh sáng thôi.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_7",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_2"
  },
  {
    "start": 23.02,
    "end": 25.1,
    "text": "Ánh sáng phản xạ từ vật thể...",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_8",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_2"
  },
  {
    "start": 25.3,
    "end": 29.02,
    "text": "...mà chúng ta thấy được vì có giác quan cảm nhận nó.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "3d2fdc7f4b884ad0893be2abd2322cec_text_9",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "3d2fdc7f4b884ad0893be2abd2322cec_panel_2"
  },
  {
    "start": 30.08,
    "end": 32.84,
    "text": "Có câu thoại trong phim truyền hình không...",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_0",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 33.04,
    "end": 35.82,
    "text": "...nói rằng, \"Khi gặp người mình yêu,",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_1",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 35.82,
    "end": 39.0,
    "text": "thế giới của tôi bắt đầu rực rỡ\"?",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_1",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 39.2,
    "end": 44.36,
    "text": "Đó không phải ẩn dụ. Tôi nghĩ nó thực sự xảy ra.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_3",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 44.56,
    "end": 45.64,
    "text": "À?",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_5",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 45.84,
    "end": 47.28,
    "text": "Câu thoại?",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_6",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_0"
  },
  {
    "start": 48.33,
    "end": 50.21,
    "text": "Khi đang yêu...",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_7",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_1"
  },
  {
    "start": 51.25,
    "end": 53.25,
    "text": "Cảm giác về thế giới...",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_8",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_2"
  },
  {
    "start": 53.45,
    "end": 55.04,
    "text": "...trở nên nhạy bén hơn.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_9",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_2"
  },
  {
    "start": 56.08,
    "end": 58.12,
    "text": "NÓ TRỞ NÊN LÁP LÁNH RỒI.",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_10",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_3"
  },
  {
    "start": 60.17,
    "end": 61.54,
    "text": "NHƯ BÌNH THƯỜNG",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_11",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_5"
  },
  {
    "start": 61.74,
    "end": 65.2,
    "text": "...TÔI KHÔNG HIỂU 100% CÔ ẤY NÓI GÌ,",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_12",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_5"
  },
  {
    "start": 65.2,
    "end": 68.23,
    "text": "NHƯNG TÔI VUI VÌ NÓ LÁP LÁNH.",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "dec8c9233ddf42438fcfbc53ef0e24d3_text_12",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "dec8c9233ddf42438fcfbc53ef0e24d3_panel_5"
  },
  {
    "start": 73.25,
    "end": 75.33,
    "text": "NHÌN KIA KIA!",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "f1b1a2520a454a3d998f7608f5074827_text_0",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "f1b1a2520a454a3d998f7608f5074827_panel_4"
  },
  {
    "start": 75.53,
    "end": 77.09,
    "text": "BẮT ĐƯỢC RỒI!",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "f1b1a2520a454a3d998f7608f5074827_text_2",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "f1b1a2520a454a3d998f7608f5074827_panel_4"
  },
  {
    "start": 77.29,
    "end": 78.11,
    "text": "À?",
    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "f1b1a2520a454a3d998f7608f5074827_text_3",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "f1b1a2520a454a3d998f7608f5074827_panel_4"
  },
  {
    "start": 79.17,
    "end": 81.49,
    "text": "NÓ TỪ ĐÂU RA?!",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "eb2503886b3548f0bb7bbd1745c4c8d1_text_0",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "eb2503886b3548f0bb7bbd1745c4c8d1_panel_0"
  },
  {
    "start": 81.69,
    "end": 86.25,
    "text": "CHÚNG TA CHƠI \"ĐÁP CỌC\" CŨNG THỬ!",
    "speaker_id": "dfa88b7302144346acb4eb1cc193be39",
    "dialogue_id": "eb2503886b3548f0bb7bbd1745c4c8d1_text_1",
    "color": "#f980c7",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
      "margin": 35
    },
    "panel_id": "eb2503886b3548f0bb7bbd1745c4c8d1_panel_0"
  },
  {
    "start": 87.25,
    "end": 89.41,

    "speaker_id": "54804134a0ec4a5eb2f997cdecb0d115",
    "dialogue_id": "eb2503886b3548f0bb7bbd1745c4c8d1_text_3",
    "color": "#66a1ff",
    "timing_source": "audio",
    "settings": {
      "enabled": true,
      "text_source": "translation",
      "translation_language": "vi",
      "max_words": 12,
      "font": "Arial",
      "font_size": 32,
      "position": "bottom",
      "alignment": "center",
      "character_colors": true,
      "color": "#ffffff",
